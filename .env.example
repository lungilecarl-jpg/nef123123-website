# ==============================================================================
# NEF123123 — Safe Phase 1 Environment Configuration (Optional Variables Only)
# Safe disabled defaults apply automatically when omitted.
# Do NOT add fake credentials or Phase 2 secrets (Resend, VAPID, GSC OAuth,
# or Subscriber Tokens) during Safe Phase 1 — those integrations are disabled.
# ==============================================================================

# --- Core Server & Safeguard Defaults (Optional) ---
PORT=3000
OFFICIAL_SITE_ORIGIN=https://www.nef123123.co.za

# Hard Safe Phase 1 Safeguards (Must Remain "false" Until Phase 2 Approval)
LIVE_SUBSCRIBER_SYSTEM_ENABLED=false
GSC_API_ENABLED=false
EMAIL_ALERTS_ENABLED=false
BROWSER_PUSH_ENABLED=false

# --- Administrator Verification (Optional Server-Side Config) ---
# Defaults safely on server; keep strictly server-side (never prefix with VITE_)
ADMIN_EMAIL=
FIREBASE_PROJECT_ID=animated-pad-gpz3c

# --- Optional Google Sign-In Placeholders for /admin (Public Browser Config) ---
# Leave blank during Safe Phase 1 until you choose to supply Firebase Web App config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=animated-pad-gpz3c
VITE_FIREBASE_APP_ID=

# --- Optional Stateless Search Indexing Key (Server-Side Only) ---
# Leave blank to keep IndexNow in safe skipped_unconfigured mode.
INDEXNOW_KEY=

# --- Optional Stateless WebSub Hub Notification (Phase 2, Safe-Disabled by Default) ---
# Keep WEBSUB_PING_ENABLED=false until you explicitly choose to push live hub pings.
WEBSUB_PING_ENABLED=false
WEBSUB_HUB_URL=https://pubsubhubbub.appspot.com/

# --- Phase 3 Option 1: External Publishing Bridge (Zero-Database, Safe-Disabled by Default) ---
# Bridge makes ZERO outbound calls until ALL THREE are configured and verified:
#   1) EXTERNAL_PUBLISHING_BRIDGE_ENABLED=true
#   2) APPROVED_PUBLISHING_FEED_URL=<verified public https:// feed URL>
#   3) APPROVED_PUBLISHING_APPROVAL_SECRET=<server-only HMAC-SHA256 secret >= 32 chars>
EXTERNAL_PUBLISHING_BRIDGE_ENABLED=false
APPROVED_PUBLISHING_FEED_URL=
APPROVED_PUBLISHING_APPROVAL_SECRET=
APPROVED_PUBLISHING_FEED_TOKEN=
APPROVED_PUBLISHING_ALLOWED_APPROVERS=
APPROVED_PUBLISHING_SYNC_INTERVAL_SECONDS=60


